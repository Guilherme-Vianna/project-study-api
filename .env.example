APP_NAME=project-study-api
ENVIRONMENT=local
DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=*
PORT=8080

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_ECHO=false
RUN_MIGRATIONS_ON_STARTUP=true
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app_test

FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_CREDENTIALS_BASE64=
FIREBASE_AUTH_EMULATOR_HOST=

INVITE_BASE_URL=http://localhost:3000/invites

GCS_BUCKET_NAME=project-study-images
GCS_PROJECT_ID=
GCS_PUBLIC_BASE_URL=http://localhost:4443/project-study-images
STORAGE_EMULATOR_HOST=http://localhost:4443
IMAGE_MAX_BYTES=5242880

STUDY_TIMEZONE=America/Sao_Paulo

LLM_PROVIDER=google_genai
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=
LLM_EXTRA_BODY=
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=120
LLM_FALLBACK_PROVIDER=deepseek
LLM_FALLBACK_MODEL=deepseek-flash
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_EXTRA_BODY={"thinking": {"type": "disabled"}}

REDIS_URL=
CACHE_TTL_SECONDS=600
K_REVISION=local
