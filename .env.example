APP_NAME=project-study-api
ENVIRONMENT=local
DEBUG=false
API_V1_PREFIX=/api/v1
PORT=8080

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_ECHO=false
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app_test

FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_AUTH_EMULATOR_HOST=

INVITE_BASE_URL=http://localhost:3000/invites

GCS_BUCKET_NAME=project-study-images
GCS_PROJECT_ID=
GCS_PUBLIC_BASE_URL=http://localhost:4443/project-study-images
STORAGE_EMULATOR_HOST=http://localhost:4443
IMAGE_MAX_BYTES=5242880

STUDY_TIMEZONE=America/Sao_Paulo
